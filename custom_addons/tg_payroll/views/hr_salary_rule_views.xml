<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_salary_rule_form_inherit_tg_payroll" model="ir.ui.view">
        <field name="name">hr.salary.rule.form.inherit.tg_payroll</field>
        <field name="model">hr.salary.rule</field>
        <field name="inherit_id" ref="hr_payroll.hr_salary_rule_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount_select']" position="after">
                <field name="skip_currency_round"/>
            </xpath>
        </field>
    </record>

</odoo>
