<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_payslip_form_inherit" model="ir.ui.view">
        <field name="name">hr.payslip.form.inherit.tg_payroll</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payslip_run_id']" position="after">
                <field name="kpi_grade" readonly="state in ['cancel', 'validated', 'paid']"/>
                <field name="kpi_grade_amount"
                       invisible="not kpi_grade"
                       readonly="1"/>
            </xpath>
        </field>
    </record>

</odoo>
