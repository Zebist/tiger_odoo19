<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ============================================================
             薪资结构
             ============================================================ -->

        <record id="tg_struct_bd_worker" model="hr.payroll.structure">
            <field name="name">BD_WORKER</field>
            <field name="type_id" ref="tg_struct_type_bd_worker"/>
            <field name="country_id" eval="False"/>
            <field name="rule_ids" eval="[]"/>
            <field name="input_line_type_ids" eval="[
                (4, ref('tg_payroll.input_type_abs')),
                (4, ref('tg_payroll.input_type_late')),
                (4, ref('tg_payroll.input_type_ot')),
                (4, ref('tg_payroll.input_type_kpi_bonus')),
                (4, ref('tg_payroll.input_type_adj')),
                (4, ref('tg_payroll.input_type_night')),
                (4, ref('tg_payroll.input_type_prod')),
            ]"/>
        </record>

        <!-- 让结构类型的默认结构指向上面的 BD_WORKER -->
        <record id="tg_struct_type_bd_worker" model="hr.payroll.structure.type">
            <field name="default_struct_id" ref="tg_struct_bd_worker"/>
        </record>

        <record id="tg_struct_bd_intern" model="hr.payroll.structure">
            <field name="name">BD_IN</field>
            <field name="type_id" ref="tg_struct_type_bd_intern"/>
            <field name="country_id" eval="False"/>
            <field name="rule_ids" eval="[]"/>
            <field name="input_line_type_ids" eval="[
                (4, ref('tg_payroll.input_type_abs')),
                (4, ref('tg_payroll.input_type_late')),
                (4, ref('tg_payroll.input_type_ot')),
                (4, ref('tg_payroll.input_type_kpi_bonus')),
                (4, ref('tg_payroll.input_type_adj')),
            ]"/>
        </record>

        <record id="tg_struct_type_bd_intern" model="hr.payroll.structure.type">
            <field name="default_struct_id" ref="tg_struct_bd_intern"/>
        </record>

        <!-- ============================================================
             BD_WORKER 薪资规则
             ============================================================ -->

        <!-- 10: Basic Salary -->
        <record id="tg_rule_bd_worker_basic" model="hr.salary.rule">
            <field name="struct_id" ref="tg_struct_bd_worker"/>
            <field name="name">Basic Salary</field>
            <field name="code">BASIC</field>
            <field name="sequence">10</field>
            <field name="category_id" ref="hr_payroll.BASIC"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = payslip._prorate(version.basic_amount)</field>
        </record>

        <!-- 20: House Rent Allowance -->
        <record id="tg_rule_bd_worker_hra" model="hr.salary.rule">
            <field name="struct_id" ref="tg_struct_bd_worker"/>
            <field name="name">House Rent Allowance</field>
            <field name="code">HRA</field>
            <field name="sequence">20</field>
            <field name="category_id" ref="hr_payroll.ALW"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = payslip._prorate(version.hra_amount)</field>
        </record>

        <!-- 30: Medical Allowance -->
        <record id="tg_rule_bd_worker_medical" model="hr.salary.rule">
            <field name="struct_id" ref="tg_struct_bd_worker"/>
            <field name="name">Medical Allowance</field>
            <field name="code">MEDICAL</field>
            <field name="sequence">30</field>
            <field name="category_id" ref="hr_payroll.ALW"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = payslip._prorate(version.medical_amount)</field>
        </record>

        <!-- 40: Conveyance Allowance -->
        <record id="tg_rule_bd_worker_conv" model="hr.salary.rule">
            <field name="struct_id" ref="tg_struct_bd_worker"/>
            <field name="name">Conveyance Allowance</field>
            <field name="code">CONV</field>
            <field name="sequence">40</field>
            <field name="category_id" ref="hr_payroll.ALW"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = payslip._prorate(version.conveyance_amount)</field>
        </record>

        <!-- 50: Overtime Pay -->
        <record id="tg_rule_bd_worker_ot" model="hr.salary.rule">
            <field name="struct_id" ref="tg_struct_bd_worker"/>
            <field name="name">Overtime Pay</field>
            <field name="code">OT_PAY</field>
            <field name="sequence">50</field>
            <field name="category_id" ref="hr_payroll.ALW"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = payslip._compute_ot()</field>
        </record>

        <!-- 60: Perfect Attendance Bonus -->
        <record id="tg_rule_bd_worker_perfect_attend" model="hr.salary.rule">
            <field name="struct_id" ref="tg_struct_bd_worker"/>
            <field name="name">Perfect Attendance Bonus</field>
            <field name="code">PERF_ATT</field>
            <field name="sequence">60</field>
            <field name="category_id" ref="hr_payroll.ALW"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = payslip._compute_perfect_attend()</field>
        </record>

        <!-- 70: Adjustment -->
        <record id="tg_rule_bd_worker_adj" model="hr.salary.rule">
            <field name="struct_id" ref="tg_struct_bd_worker"/>
            <field name="name">Adjustment</field>
            <field name="code">ADJ</field>
            <field name="sequence">70</field>
            <field name="category_id" ref="hr_payroll.ALW"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = payslip._compute_adj()</field>
        </record>

        <!-- 75: Night Shift Allowance — 直读 NIGHT input -->
        <record id="tg_rule_bd_worker_night" model="hr.salary.rule">
            <field name="struct_id" ref="tg_struct_bd_worker"/>
            <field name="name">Night Shift Allowance</field>
            <field name="code">NIGHT_PAY</field>
            <field name="sequence">75</field>
            <field name="category_id" ref="hr_payroll.ALW"/>
            <field name="condition_select">none</field>
            <field name="amount_select">input</field>
            <field name="amount_other_input_id" ref="input_type_night"/>
        </record>

        <!-- 76: Production Award — 直读 PROD input -->
        <record id="tg_rule_bd_worker_prod" model="hr.salary.rule">
            <field name="struct_id" ref="tg_struct_bd_worker"/>
            <field name="name">Production Award</field>
            <field name="code">PROD_PAY</field>
            <field name="sequence">76</field>
            <field name="category_id" ref="hr_payroll.ALW"/>
            <field name="condition_select">none</field>
            <field name="amount_select">input</field>
            <field name="amount_other_input_id" ref="input_type_prod"/>
        </record>

        <!-- 100: Late Deduction -->
        <record id="tg_rule_bd_worker_late" model="hr.salary.rule">
            <field name="struct_id" ref="tg_struct_bd_worker"/>
            <field name="name">Late Deduction</field>
            <field name="code">LATE_DED</field>
            <field name="sequence">100</field>
            <field name="category_id" ref="hr_payroll.DED"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = payslip._compute_late_ded()</field>
        </record>

        <!-- 110: Absence Deduction -->
        <record id="tg_rule_bd_worker_abs" model="hr.salary.rule">
            <field name="struct_id" ref="tg_struct_bd_worker"/>
            <field name="name">Absence Deduction</field>
            <field name="code">ABS_DED</field>
            <field name="sequence">110</field>
            <field name="category_id" ref="hr_payroll.DED"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = payslip._compute_abs_ded()</field>
        </record>

        <!-- 120: AIT — 调 payslip._compute_ait()，逻辑在 models/hr_payslip.py 统一维护 -->
        <record id="tg_rule_bd_worker_ait" model="hr.salary.rule">
            <field name="struct_id" ref="tg_struct_bd_worker"/>
            <field name="name">AIT (Income Tax)</field>
            <field name="code">AIT</field>
            <field name="sequence">120</field>
            <field name="category_id" ref="hr_payroll.DED"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = payslip._compute_ait()</field>
        </record>

        <!-- 999: Net Salary -->
        <record id="tg_rule_bd_worker_net" model="hr.salary.rule">
            <field name="struct_id" ref="tg_struct_bd_worker"/>
            <field name="name">Net Salary</field>
            <field name="code">NET</field>
            <field name="sequence">999</field>
            <field name="category_id" ref="hr_payroll.NET"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = categories['BASIC'] + categories['ALW'] + categories['DED']</field>
        </record>

        <!-- ============================================================
             BD_IN 薪资规则（实习生）
             ============================================================ -->

        <!-- 10: Monthly Stipend — wage × (active/total)，处理跨月入/离职 -->
        <record id="tg_rule_bd_intern_stipend" model="hr.salary.rule">
            <field name="struct_id" ref="tg_struct_bd_intern"/>
            <field name="name">Monthly Stipend</field>
            <field name="code">STIPEND</field>
            <field name="sequence">10</field>
            <field name="category_id" ref="hr_payroll.BASIC"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = payslip._prorate(version.wage)</field>
        </record>

        <!-- 100: Late Deduction -->
        <record id="tg_rule_bd_intern_late" model="hr.salary.rule">
            <field name="struct_id" ref="tg_struct_bd_intern"/>
            <field name="name">Late Deduction</field>
            <field name="code">LATE_DED</field>
            <field name="sequence">100</field>
            <field name="category_id" ref="hr_payroll.DED"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = payslip._compute_late_ded()</field>
        </record>

        <!-- 110: Absence Deduction -->
        <record id="tg_rule_bd_intern_abs" model="hr.salary.rule">
            <field name="struct_id" ref="tg_struct_bd_intern"/>
            <field name="name">Absence Deduction</field>
            <field name="code">ABS_DED</field>
            <field name="sequence">110</field>
            <field name="category_id" ref="hr_payroll.DED"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = payslip._compute_abs_ded()</field>
        </record>

        <!-- 120: AIT — 调 payslip._compute_ait()，逻辑在 models/hr_payslip.py 统一维护 -->
        <record id="tg_rule_bd_intern_ait" model="hr.salary.rule">
            <field name="struct_id" ref="tg_struct_bd_intern"/>
            <field name="name">AIT (Income Tax)</field>
            <field name="code">AIT</field>
            <field name="sequence">120</field>
            <field name="category_id" ref="hr_payroll.DED"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = payslip._compute_ait()</field>
        </record>

        <!-- 999: Net Salary -->
        <record id="tg_rule_bd_intern_net" model="hr.salary.rule">
            <field name="struct_id" ref="tg_struct_bd_intern"/>
            <field name="name">Net Salary</field>
            <field name="code">NET</field>
            <field name="sequence">999</field>
            <field name="category_id" ref="hr_payroll.NET"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = categories['BASIC'] + categories['ALW'] + categories['DED']</field>
        </record>

    </data>
</odoo>
