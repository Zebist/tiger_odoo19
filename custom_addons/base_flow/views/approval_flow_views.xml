<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_approval_flow_list" model="ir.ui.view">
        <field name="name">approval.flow.list</field>
        <field name="model">approval.flow</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="model_id"/>
                <field name="company_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_approval_flow_form" model="ir.ui.view">
        <field name="name">approval.flow.form</field>
        <field name="model">approval.flow</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="model_id"/>
                        <field name="company_id"/>
                        <field name="stage_model_id" />
                        <field name="active"/>
                    </group>
                    <notebook>
                        <page string="Nodes">
                            <field name="node_ids">
                                <list editable="bottom">
                                    <field name="level"/>
                                    <field name="name"/>
                                    <field name="user_id" required="level"/>
                                    <field name="stage_res_model" column_invisible="1" />
                                    <field name="stage_id" />
                                    <field name="action_id"/>
                                    <field name="active" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_approval_flow" model="ir.actions.act_window">
        <field name="name">Approval Flows</field>
        <field name="res_model">approval.flow</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

