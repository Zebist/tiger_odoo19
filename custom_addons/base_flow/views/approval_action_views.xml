<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_approval_action_list" model="ir.ui.view">
        <field name="name">approval.action.list</field>
        <field name="model">approval.action</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active"/>
                <field name="code"/>
            </list>
        </field>
    </record>

    <record id="view_approval_action_form" model="ir.ui.view">
        <field name="name">approval.action.form</field>
        <field name="model">approval.action</field>
        <field name="arch" type="xml">
            <form string="Approval Action">
                <sheet>
                    <group>
                        <field name="active"/>
                        <field name="sequence"/>
                        <field name="name"/>
                    </group>
                    <group>
                        <field name="code" placeholder="e.g. post_message" />
                        <field name="python_code" widget="ace" options="{'mode': 'python'}"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_approval_action" model="ir.actions.act_window">
        <field name="name">Approval Actions</field>
        <field name="res_model">approval.action</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

