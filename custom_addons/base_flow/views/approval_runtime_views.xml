<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_approval_runtime_form" model="ir.ui.view">
        <field name="name">approval.runtime.form</field>
        <field name="model">approval.runtime</field>
        <field name="arch" type="xml">
            <form string="Approval Runtime">
                <sheet>
                    <group>
                        <field name="flow_id" readonly="1"/>
                        <field name="document_ref" widget="reference" readonly="1"/>
                        <field name="current_line_id" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Lines">
                            <field name="line_ids" readonly="1">
                                <list create="0" edit="0" delete="0">
                                    <field name="level"/>
                                    <field name="node_id"/>
                                    <field name="approver_id"/>
                                    <field name="state"/>
                                    <field name="action_by"/>
                                    <field name="action_date"/>
                                </list>
                                <form string="Approval Runtime Line">
                                    <sheet>
                                        <group>
                                            <field name="level" readonly="1"/>
                                            <field name="node_id" readonly="1"/>
                                            <field name="approver_id" readonly="1"/>
                                            <field name="state" readonly="1"/>
                                        </group>
                                        <group>
                                            <field name="action_by" readonly="1"/>
                                            <field name="action_date" readonly="1"/>
                                        </group>
                                        <group>
                                            <field name="note" readonly="1"/>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>

