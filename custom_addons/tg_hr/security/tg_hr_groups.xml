<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_tg_hr" model="ir.module.category">
        <field name="name">Tiger / HR</field>
        <field name="sequence">32</field>
    </record>

    <record id="res_groups_privilege_tg_hr_requisition" model="res.groups.privilege">
        <field name="name">Requisition</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="tg_hr.module_category_tg_hr"/>
    </record>

    <record id="group_tg_hr_requisition_terminate" model="res.groups">
        <field name="name">Terminate Recruitment</field>
        <field name="privilege_id" ref="tg_hr.res_groups_privilege_tg_hr_requisition"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Onboarding 权限 -->
    <record id="res_groups_privilege_tg_hr_onboarding" model="res.groups.privilege">
        <field name="name">Onboarding</field>
        <field name="sequence">20</field>
        <field name="category_id" ref="tg_hr.module_category_tg_hr"/>
    </record>

    <!-- 部门经理：可查看本部门员工信息 -->
    <record id="group_tg_hr_onboarding_dept_manager" model="res.groups">
        <field name="name">Onboarding Department Manager</field>
        <field name="privilege_id" ref="tg_hr.res_groups_privilege_tg_hr_onboarding"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Onboarding 管理员：完整权限（包含部门经理权限）-->
    <record id="group_tg_hr_onboarding_admin" model="res.groups">
        <field name="name">Onboarding Administrator</field>
        <field name="privilege_id" ref="tg_hr.res_groups_privilege_tg_hr_onboarding"/>
        <field name="implied_ids" eval="[(4, ref('tg_hr.group_tg_hr_onboarding_dept_manager'))]"/>
    </record>

    <!-- Offer Email 权限 -->
    <record id="res_groups_privilege_tg_hr_offer_email" model="res.groups.privilege">
        <field name="name">Offer Email</field>
        <field name="sequence">30</field>
        <field name="category_id" ref="tg_hr.module_category_tg_hr"/>
    </record>

    <!-- 允许手动发送/重发 Offer 邮件、操作 sign 流程（Company Sign / Send Sign Link / Recreate Sign Request 等） -->
    <record id="group_hr_offer_email_sender" model="res.groups">
        <field name="name">Offer Email Sender</field>
        <field name="privilege_id" ref="tg_hr.res_groups_privilege_tg_hr_offer_email"/>
        <field name="implied_ids" eval="[
            (4, ref('sign.group_sign_user')),
        ]"/>
    </record>

    <!-- Employee Onboarding 权限（Confirm Contract 等） -->
    <record id="res_groups_privilege_tg_hr_employee_onboard" model="res.groups.privilege">
        <field name="name">Employee Onboarding</field>
        <field name="sequence">40</field>
        <field name="category_id" ref="tg_hr.module_category_tg_hr"/>
    </record>

    <!-- 允许 confirm employee 合同（首次入职走 wizard 填写日期 + onboarding checklist） -->
    <record id="group_hr_employee_contract_confirm" model="res.groups">
        <field name="name">Employee Contract Confirm</field>
        <field name="privilege_id" ref="tg_hr.res_groups_privilege_tg_hr_employee_onboard"/>
        <field name="implied_ids" eval="[(4, ref('hr.group_hr_user'))]"/>
    </record>
</odoo>
