<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_tg_hr" model="ir.module.category">
        <field name="name">Tiger / HR</field>
        <field name="sequence">32</field>
    </record>

    <!-- 预置 res.users.role 的「壳」组挂在 User roles 分类下，便于权限页归类 -->
    <record id="res_groups_privilege_tg_hr_role" model="res.groups.privilege">
        <field name="name">Tiger HR Roles</field>
        <field name="sequence">90</field>
        <field name="category_id" ref="base_user_role.ir_module_category_role"/>
    </record>

    <record id="res_groups_privilege_tg_hr_requisition" model="res.groups.privilege">
        <field name="name">Tiger Requisition</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="tg_hr.module_category_tg_hr"/>
    </record>

    <record id="group_tg_hr_requisition_terminate" model="res.groups">
        <field name="name">Terminate Recruitment</field>
        <field name="privilege_id" ref="tg_hr.res_groups_privilege_tg_hr_requisition"/>
        <field name="implied_ids" eval="[(6, 0, [])]"/>
    </record>

    <!-- 仅授予 tg.hr.requisition 的创建权限（与 Officer ACL 合并后才具备完整增删改查） -->
    <record id="group_tg_hr_requisition_creator" model="res.groups">
        <field name="name">Requisition Creator</field>
        <field name="privilege_id" ref="tg_hr.res_groups_privilege_tg_hr_requisition"/>
        <field name="implied_ids" eval="[(6, 0, [])]"/>
    </record>

    <!-- 候选人表单 / Kanban 流水线操作按钮（与 Officer 分离，便于角色组合） -->
    <record id="group_tg_hr_recruitment_applicant_actions" model="res.groups">
        <field name="name">Recruitment Applicant Pipeline Actions</field>
        <field name="privilege_id" ref="tg_hr.res_groups_privilege_tg_hr_requisition"/>
        <field name="implied_ids" eval="[(6, 0, [])]"/>
    </record>

    <!-- hr.recruitment.degree 只读 ACL 专用组（与流水线动作组分离） -->
    <record id="group_tg_hr_recruitment_degree_readonly" model="res.groups">
        <field name="name">Recruitment Degree Readonly</field>
        <field name="privilege_id" ref="tg_hr.res_groups_privilege_tg_hr_requisition"/>
        <field name="implied_ids" eval="[(6, 0, [])]"/>
    </record>

    <!-- hr.applicant 普用户全量 CRUD + 见 ir.rule（自建 / Assigned HR=自己 / Assigned HR 为空） -->
    <record id="group_tg_hr_recruitment_applicant_normal_edit" model="res.groups">
        <field name="name">Recruitment Applicant Normal User (Edit — Own, Assigned HR, or Unassigned)</field>
        <field name="privilege_id" ref="tg_hr.res_groups_privilege_tg_hr_requisition"/>
        <field name="implied_ids" eval="[(6, 0, [])]"/>
    </record>

    <!-- 入职档案 privilege：档案管理员组；仅 hr.applicant ACL + ir.rule；Onboarding 页仅该组可见 -->
    <record id="res_groups_privilege_tg_hr_applicant_records" model="res.groups.privilege">
        <field name="name">Onboarding Records</field>
        <field name="sequence">12</field>
        <field name="category_id" ref="tg_hr.module_category_tg_hr"/>
    </record>

    <record id="group_tg_hr_applicant_records_admin" model="res.groups">
        <field name="name">Applicant Records Administrator</field>
        <field name="privilege_id" ref="tg_hr.res_groups_privilege_tg_hr_applicant_records"/>
        <field name="implied_ids" eval="[(6, 0, [])]"/>
    </record>

    <!-- Onboarding + Employee Contract Confirm 共用同一 privilege（原 Employee Onboarding 已合并） -->
    <record id="res_groups_privilege_tg_hr_onboarding" model="res.groups.privilege">
        <field name="name">Tiger Onboarding</field>
        <field name="sequence">20</field>
        <field name="category_id" ref="tg_hr.module_category_tg_hr"/>
    </record>

    <record id="group_tg_hr_onboarding_dept_manager" model="res.groups">
        <field name="name">Onboarding Department Manager</field>
        <field name="privilege_id" ref="tg_hr.res_groups_privilege_tg_hr_onboarding"/>
    </record>

    <!-- Create Employee 向导与表单按钮（入职档案） -->
    <record id="group_tg_hr_onboarding_create_employee" model="res.groups">
        <field name="name">Onboarding Create Employee</field>
        <field name="privilege_id" ref="tg_hr.res_groups_privilege_tg_hr_onboarding"/>
    </record>

    <!-- 入职档案：不挂 hr.group_hr_user，避免获得标准 hr.version 写权限；见 ACL + employee 记录规则 -->
    <record id="group_tg_hr_onboarding_records_core" model="res.groups">
        <field name="name">Onboarding Records Core</field>
        <field name="privilege_id" ref="tg_hr.res_groups_privilege_tg_hr_onboarding"/>
    </record>

    <!-- 员工表单「Create User」向导（sudo 建账号）；仅显式授予此组，不随 Records Core 附带 -->
    <record id="group_tg_hr_employee_create_user_wizard" model="res.groups">
        <field name="name">Employee Create User (Wizard)</field>
        <field name="privilege_id" ref="tg_hr.res_groups_privilege_tg_hr_onboarding"/>
    </record>

    <!-- 合同/薪酬侧：显式 hr.version 全权限（可与 hr.group_hr_user 叠加） -->
    <record id="group_hr_version_contract_admin" model="res.groups">
        <field name="name">HR Version Contract Administrator</field>
        <field name="privilege_id" ref="tg_hr.res_groups_privilege_tg_hr_onboarding"/>
    </record>

    <!-- hr.version 仅读 ACL 专用组（无记录规则） -->
    <record id="group_tg_hr_version_readonly" model="res.groups">
        <field name="name">HR Version Readonly</field>
        <field name="privilege_id" ref="tg_hr.res_groups_privilege_tg_hr_onboarding"/>
        <field name="implied_ids" eval="[(6, 0, [])]"/>
    </record>

    <record id="res_groups_privilege_tg_hr_applicant_stage" model="res.groups.privilege">
        <field name="name">Tiger Applicant Stage</field>
        <field name="sequence">25</field>
        <field name="category_id" ref="tg_hr.module_category_tg_hr"/>
    </record>

    <record id="group_hr_applicant_contract_signed_stage_override" model="res.groups">
        <field name="name">Applicant Contract Signed Stage Override</field>
        <field name="privilege_id" ref="tg_hr.res_groups_privilege_tg_hr_applicant_stage"/>
        <field name="implied_ids" eval="[(6, 0, [])]"/>
    </record>

    <record id="res_groups_privilege_tg_hr_offer_email" model="res.groups.privilege">
        <field name="name">Tiger Offer Email</field>
        <field name="sequence">30</field>
        <field name="category_id" ref="tg_hr.module_category_tg_hr"/>
    </record>

    <record id="group_hr_offer_email_sender" model="res.groups">
        <field name="name">Offer Email Sender</field>
        <field name="comment">Offer 相关按钮/RPC；候选人侧 hr.contract.salary.offer 见 tg_hr ACL 与 rule_hr_contract_salary_offer_applicant_pipeline_applicant（仅本组）。流水线操作组见 rule_hr_contract_salary_offer_applicant_pipeline_all。</field>
        <field name="privilege_id" ref="tg_hr.res_groups_privilege_tg_hr_offer_email"/>
        <field name="implied_ids" eval="[(6, 0, [])]"/>
    </record>

    <record id="group_hr_employee_contract_confirm" model="res.groups">
        <field name="name">Employee Contract Confirm</field>
        <field name="privilege_id" ref="tg_hr.res_groups_privilege_tg_hr_onboarding"/>
        <field name="implied_ids" eval="[(6, 0, [])]"/>
    </record>

    <!-- 员工主数据只读：hr.employee ACL 1,0,0,0 -->
    <record id="res_groups_privilege_tg_hr_employee_info" model="res.groups.privilege">
        <field name="name">Tiger Employee Information</field>
        <field name="sequence">15</field>
        <field name="category_id" ref="tg_hr.module_category_tg_hr"/>
    </record>

    <record id="group_tg_hr_employee_info_readonly" model="res.groups">
        <field name="name">Employee Information Readonly</field>
        <field name="privilege_id" ref="tg_hr.res_groups_privilege_tg_hr_employee_info"/>
    </record>
</odoo>
