<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- 部门经理：可查看本部门员工记录 -->
    <record id="rule_hr_employee_dept_manager_read" model="ir.rule">
        <field name="name">Employee: department manager sees department</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="domain_force">[('department_id.manager_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('tg_hr.group_tg_hr_onboarding_dept_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- 入职档案核心组：可访问全部员工（与 base.group_user 本人规则 OR，避免只能看自己） -->
    <record id="rule_hr_employee_onboarding_records_core_all" model="ir.rule">
        <field name="name">Employee: onboarding records core full access</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('tg_hr.group_tg_hr_onboarding_records_core'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Onboarding 管理员：所有员工记录完整权限 -->
    <record id="rule_hr_employee_onboarding_admin_all" model="ir.rule">
        <field name="name">Employee: onboarding admin full access</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('tg_hr.group_tg_hr_applicant_records_admin'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Recruitment Applicant Pipeline Actions：全部 hr.employee（与其它组规则 OR，便于 Many2one 等读到全员） -->
    <record id="rule_hr_employee_applicant_pipeline_all" model="ir.rule">
        <field name="name">Employee: applicant pipeline sees all employees</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('tg_hr.group_tg_hr_recruitment_applicant_actions'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- 普用户编辑组：仅本人创建的、或 Assigned HR 为本人、或 Assigned HR 为空的候选人 -->
    <record id="rule_hr_applicant_tg_normal_edit_own_assigned_or_unassigned" model="ir.rule">
        <field name="name">Applicant: normal edit (own create, assigned HR self, or unassigned HR)</field>
        <field name="model_id" ref="hr_recruitment.model_hr_applicant"/>
        <field name="domain_force">['|', '|', ('create_uid', '=', user.id), ('assigned_hr_id', '=', user.id), ('assigned_hr_id', '=', False)]</field>
        <field name="groups" eval="[(4, ref('tg_hr.group_tg_hr_recruitment_applicant_normal_edit'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- 档案管理员：Offered / Contract Signed 全量可见；其余阶段仅自建 / Assigned HR=本人 / 未分配 HR -->
    <!-- 与 hr_recruitment_security.xml 一致：domain 存为文本，运行期 safe_eval 才有 user； -->
    <!-- Odoo 19 Domain 前缀式：n 个条件需 n-1 个「|」且全部并列，见 odoo/orm/domains.py 反转栈解析 -->
    <record id="rule_hr_applicant_tg_records_admin" model="ir.rule">
        <field name="name">Applicant: records admin (offered or contract signed or own/assigned/unassigned)</field>
        <field name="model_id" ref="hr_recruitment.model_hr_applicant"/>
        <field name="domain_force" eval="'[\'|\', \'|\', \'|\', \'|\', (\'stage_id\', \'=\', ' + str(ref('tg_hr.hr_recruitment_stage_tg_offered')) + '), (\'stage_id\', \'=\', ' + str(ref('hr_recruitment.stage_job5')) + '), (\'create_uid\', \'=\', ' + 'user' + '.id), (\'assigned_hr_id\', \'=\', ' + 'user' + '.id), (\'assigned_hr_id\', \'=\', False)]'"/>
        <field name="groups" eval="[(4, ref('tg_hr.group_tg_hr_applicant_records_admin'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Recruitment Applicant Pipeline Actions：招聘需求可见「已提交审批」或「阶段为 Terminated」 -->
    <record id="rule_tg_hr_requisition_applicant_pipeline_non_draft" model="ir.rule">
        <field name="name">Job requisition: applicant pipeline sees submitted or terminated stage only</field>
        <field name="model_id" ref="tg_hr.model_tg_hr_requisition"/>
        <field name="domain_force">['|', ('approval_state', '!=', 'draft'), ('stage_id', '=',user.env.ref('tg_hr.requisition_stage_terminated'))]</field>
        <field name="groups" eval="[(4, ref('tg_hr.group_tg_hr_recruitment_applicant_actions'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Offer Email Sender：候选人侧 Offer 域（employee_version 为空）；与 applicant pipeline 组拆分 -->
    <record id="rule_hr_contract_salary_offer_applicant_pipeline_applicant" model="ir.rule">
        <field name="name">Salary Package Offer: offer email sender sees applicant offers</field>
        <field name="model_id" ref="hr_contract_salary.model_hr_contract_salary_offer"/>
        <field name="domain_force">[('employee_version_id', '=', False)]</field>
        <field name="groups" eval="[(4, ref('tg_hr.group_hr_offer_email_sender'))]"/>
    </record>

    <!-- Recruitment Applicant Pipeline Actions：全部 hr.contract.salary.offer -->
    <record id="rule_hr_contract_salary_offer_applicant_pipeline_all" model="ir.rule">
        <field name="name">Salary Package Offer: applicant pipeline sees all offers</field>
        <field name="model_id" ref="hr_contract_salary.model_hr_contract_salary_offer"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('tg_hr.group_tg_hr_recruitment_applicant_actions'))]"/>
    </record>

    <!-- 系统管理员：可查看所有 Salary Package Offer（避免标准模块 record rule 误伤） -->
    <record id="rule_hr_contract_salary_offer_system_all_read" model="ir.rule">
        <field name="name">Salary Package Offer: system can see all</field>
        <field name="model_id" ref="hr_contract_salary.model_hr_contract_salary_offer"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
</odoo>
