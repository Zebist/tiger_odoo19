<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tg_hr_applicant_create_employee_wizard_form" model="ir.ui.view">
        <field name="name">tg.hr.applicant.create.employee.wizard.form</field>
        <field name="model">tg.hr.applicant.create.employee.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Employee">
                <group>
                    <field name="applicant_id" invisible="1"/>
                    <field name="applicant_company_id" invisible="1"/>
                    <field name="department_id" options="{'no_quick_create': True}"/>
                    <field name="manager_id"/>
                    <field name="work_location_id" options="{'no_quick_create': True}"/>
                    <field name="resource_calendar_id" options="{'no_quick_create': True}"/>
                    <field name="join_date"/>
                    <field name="trial_date_end"/>
                </group>
                <div class="alert alert-info" role="alert">
                    <i class="fa fa-info-circle me-2"/>
                    <strong>Join Date</strong> is the HR onboarding date — not the contract start date.
                    Contract dates (start / end / trial) will be reviewed and confirmed on the employee
                    form via <strong>Confirm Contract</strong> after the employee is created.
                </div>
                <footer>
                    <button name="action_create_employee" type="object"
                            string="Create Employee" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
