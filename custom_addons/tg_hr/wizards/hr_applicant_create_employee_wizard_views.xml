<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tg_hr_applicant_create_employee_wizard_form" model="ir.ui.view">
        <field name="name">tg.hr.applicant.create.employee.wizard.form</field>
        <field name="model">tg.hr.applicant.create.employee.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Employee">
                <group>
                    <field name="applicant_id" invisible="1"/>
                    <field name="department_id" options="{'no_quick_create': True}"/>
                    <field name="manager_id"/>
                    <field name="work_location_id" options="{'no_quick_create': True}"/>
                    <field name="resource_calendar_id" options="{'no_quick_create': True}"/>
                </group>
                <footer>
                    <button name="action_create_employee" type="object"
                            string="Create Employee" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
