<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tg_hr_applicant_first_contact_wizard_form" model="ir.ui.view">
        <field name="name">tg.hr.applicant.first.contact.wizard.form</field>
        <field name="model">tg.hr.applicant.first.contact.wizard</field>
        <field name="arch" type="xml">
            <form string="First Contact">
                <group>
                    <field name="applicant_id" invisible="1"/>
                    <field name="first_contact_date"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
