<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!--
    Tier Validation 配置（tg.hr.requisition）

    拦截点：submitted -> hm_assigned
    说明：Reviewer/Domain 都可在界面进一步调整，本文件提供默认基线。
    -->

    <!-- 审批通过后：自动写入 Hiring Manager，并推进 Stage 到 hm_assigned -->
    <record id="server_action_requisition_to_hm_assigned" model="ir.actions.server">
        <field name="name">Requisition: Assign HM &amp; Move to HM Assigned</field>
        <field name="model_id" ref="tg_hr.model_tg_hr_requisition"/>
        <field name="state">code</field>
        <field name="code">record.action_hr_assign()</field>
    </record>

    <!-- 挂接本模块 tier.definition -->
    <record id="approval_flow_requisition" model="base.approval.flow.zb">
        <field name="name">HR Requisition Approval</field>
        <field name="company_id" ref="base.main_company"/>
        <field name="model_id" ref="tg_hr.model_tg_hr_requisition"/>
        <field name="stage_model_id" ref="tg_hr.model_tg_hr_requisition_stage"/>
        <field name="draft_stage_id" ref="tg_hr.requisition_stage_draft" />
        <field name="submit_stage_id" ref="tg_hr.requisition_stage_submitted" />
        <field name="reject_stage_id" ref="tg_hr.requisition_stage_rejected" />
        <field name="approve_stage_id" ref="tg_hr.requisition_stage_hm_assigned" />
    </record>

    <!-- Tier Definition: HR（组：Recruitment Manager，可在 UI 调整） -->
    <record id="tier_def_requisition_hr" model="tier.definition">
        <field name="name">Requisition - HR</field>
        <field name="flow_id" ref="tg_hr.approval_flow_requisition"/>
        <field name="model_id" ref="tg_hr.model_tg_hr_requisition"/>
        <field name="review_type">group</field>
        <field name="reviewer_group_id" ref="hr_recruitment.group_hr_recruitment_manager"/>
        <field name="sequence">20</field>
        <field name="approve_sequence" eval="True"/>
        <field name="has_comment" eval="True"/>
        <field name="server_action_id" ref="tg_hr.server_action_requisition_to_hm_assigned"/>
    </record>

    <!-- Tier Definition: CEO（示例：岗位名称包含 Manager 才触发；审批人组可在 UI 调整） -->
    <record id="tier_def_requisition_ceo" model="tier.definition">
        <field name="name">Requisition - CEO (Conditional)</field>
        <field name="flow_id" ref="tg_hr.approval_flow_requisition"/>
        <field name="model_id" ref="tg_hr.model_tg_hr_requisition"/>
        <field name="review_type">group</field>
        <field name="reviewer_group_id" ref="hr_recruitment.group_hr_recruitment_manager"/>
        <field name="sequence">30</field>
        <field name="approve_sequence" eval="True"/>
        <field name="has_comment" eval="True"/>
        <field name="definition_domain">[('job_id.is_manager', '=', True)]</field>
        <field name="server_action_id" ref="tg_hr.server_action_requisition_to_hm_assigned"/>
    </record>

    <!-- ==================== Offer Approval Flow (hr.contract.salary.offer) ==================== -->

    <record id="approval_flow_applicant_offer" model="base.approval.flow.zb">
        <field name="name">HR Offer Approval</field>
        <field name="company_id" ref="base.main_company"/>
        <field name="model_id" ref="hr_contract_salary.model_hr_contract_salary_offer"/>
    </record>

    <!-- Tier 10: HR Manager（reviewer group 由界面配置） -->
    <record id="tier_def_offer_hr_manager" model="tier.definition">
        <field name="name">Offer - HR Manager</field>
        <field name="flow_id" ref="tg_hr.approval_flow_applicant_offer"/>
        <field name="model_id" ref="hr_contract_salary.model_hr_contract_salary_offer"/>
        <field name="review_type">group</field>
        <field name="sequence">10</field>
        <field name="approve_sequence" eval="True"/>
        <field name="has_comment" eval="True"/>
    </record>

    <!-- Tier 20: Finance Manager（reviewer group 由界面配置） -->
    <record id="tier_def_offer_finance_manager" model="tier.definition">
        <field name="name">Offer - Finance Manager</field>
        <field name="flow_id" ref="tg_hr.approval_flow_applicant_offer"/>
        <field name="model_id" ref="hr_contract_salary.model_hr_contract_salary_offer"/>
        <field name="review_type">group</field>
        <field name="sequence">20</field>
        <field name="approve_sequence" eval="True"/>
        <field name="has_comment" eval="True"/>
    </record>

    <!-- Tier 30: COO（reviewer group 由界面配置） -->
    <record id="tier_def_offer_coo" model="tier.definition">
        <field name="name">Offer - COO</field>
        <field name="flow_id" ref="tg_hr.approval_flow_applicant_offer"/>
        <field name="model_id" ref="hr_contract_salary.model_hr_contract_salary_offer"/>
        <field name="review_type">group</field>
        <field name="sequence">30</field>
        <field name="approve_sequence" eval="True"/>
        <field name="has_comment" eval="True"/>
    </record>

    <!-- Tier 40: CEO（仅限经理级职位，reviewer group 由界面配置） -->
    <record id="tier_def_offer_ceo" model="tier.definition">
        <field name="name">Offer - CEO (Manager Positions Only)</field>
        <field name="flow_id" ref="tg_hr.approval_flow_applicant_offer"/>
        <field name="model_id" ref="hr_contract_salary.model_hr_contract_salary_offer"/>
        <field name="review_type">group</field>
        <field name="sequence">40</field>
        <field name="approve_sequence" eval="True"/>
        <field name="has_comment" eval="True"/>
        <field name="definition_domain">[('applicant_id.job_id.is_manager', '=', True)]</field>
    </record>
</odoo>
