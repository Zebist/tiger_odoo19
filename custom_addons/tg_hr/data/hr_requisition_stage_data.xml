<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="requisition_stage_draft" model="tg.hr.requisition.stage">
        <field name="name">Draft</field>
        <field name="code">draft</field>
        <field name="sequence">10</field>
    </record>
    <record id="requisition_stage_submitted" model="tg.hr.requisition.stage">
        <field name="name">Submitted</field>
        <field name="code">submitted</field>
        <field name="sequence">20</field>
    </record>
    <record id="requisition_stage_rejected" model="tg.hr.requisition.stage">
        <field name="name">Rejected</field>
        <field name="code">rejected</field>
        <field name="fold" eval="True"/>
        <field name="sequence">30</field>
    </record>
    <record id="requisition_stage_hm_assigned" model="tg.hr.requisition.stage">
        <field name="name">Hiring Manager Assigned</field>
        <field name="code">hm_assigned</field>
        <field name="sequence">40</field>
    </record>
    <record id="requisition_stage_hired" model="tg.hr.requisition.stage">
        <field name="name">Hired</field>
        <field name="code">hired</field>
        <field name="sequence">50</field>
        <field name="fold" eval="True"/>
    </record>
    <record id="requisition_stage_terminated" model="tg.hr.requisition.stage">
        <field name="name">Terminated</field>
        <field name="code">terminated</field>
        <field name="sequence">60</field>
        <field name="fold" eval="True"/>
    </record>
</odoo>
