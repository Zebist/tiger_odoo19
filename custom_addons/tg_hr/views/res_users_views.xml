<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_users_view_form_inherit_tg_sign_signature" model="ir.ui.view">
        <field name="name">res.users.form.inherit.tg.sign.signature</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
        <field name="arch" type="xml">
            <group name="other_preferences" position="inside">
                <group string="Digital Signature" colspan="2">
                    <field name="sign_signature" widget="signature" nolabel="1"
                           options="{'full_name': 'name'}"
                           readonly="id != uid"/>
                    <p class="text-muted" colspan="2">
                        This signature image is used when auto-signing offer letters on your behalf.
                    </p>
                </group>
            </group>
        </field>
    </record>
</odoo>
