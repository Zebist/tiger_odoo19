<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tg_hr_requisition_kanban" model="ir.ui.view">
        <field name="name">tg.hr.requisition.kanban</field>
        <field name="model">tg.hr.requisition</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id" records_draggable="0" class="o_kanban_small_column" sample="1"
                    group_create="0" quick_create="false">
                <header>
                    <button
                            name="%(tg_hr.action_tg_hr_requisition_stage_new)d"
                            type="action"
                            string="New Stage"
                            class="btn-secondary"
                            display="always"
                            groups="hr_recruitment.group_hr_recruitment_manager"
                    />
                </header>
                <field name="name"/>
                <field name="stage_id"/>
                <field name="priority"/>
                <field name="department_id"/>
                <field name="date_join_expected"/>
                <field name="hiring_manager_id"/>
                <field name="requester_id"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between align-items-start mb-1">
                            <div class="fw-bold flex-grow-1">
                                <field name="name"/>
                            </div>
                            <field name="priority" class="ms-1"/>
                        </div>
                        <div class="text-muted small">
                            <field name="department_id" invisible="not department_id"/>
                        </div>
                        <div class="text-muted small" invisible="not date_join_expected">
                            <span>Expected joining: </span>
                            <field name="date_join_expected"/>
                        </div>
                        <footer class="pt-1">
                            <field name="requester_id" widget="many2one_avatar_user"
                                   options="{'display_avatar_name': True}"/>
                            <field class="ms-auto" name="hiring_manager_id" widget="many2one_avatar_user"
                                   options="{'display_avatar_name': True}" invisible="not hiring_manager_id"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_tg_hr_requisition_tree" model="ir.ui.view">
        <field name="name">tg.hr.requisition.list</field>
        <field name="model">tg.hr.requisition</field>
        <field name="arch" type="xml">
            <list string="Requisitions">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="date_request" optional="show"/>
                <field name="date_join_expected" optional="hide"/>
                <field name="priority" optional="show"/>
                <field name="department_id" optional="show"/>
                <field name="job_id" optional="show"/>
                <field name="hiring_type" optional="hide"/>
                <field name="number_of_vacancies" optional="hide"/>
                <field name="requester_id" widget="many2one_avatar_user" optional="show"/>
                <field name="hiring_manager_id" widget="many2one_avatar_user" optional="hide"/>
                <field name="stage_code" column_invisible="1"/>
                <field name="stage_id" widget="badge" decoration-info="stage_code == 'draft'"
                       decoration-primary="stage_code == 'submitted'" decoration-warning="stage_code == 'hm_assigned'"
                       decoration-success="stage_code == 'hired'"/>
            </list>
        </field>
    </record>

    <record id="view_tg_hr_requisition_form" model="ir.ui.view">
        <field name="name">tg.hr.requisition.form</field>
        <field name="model">tg.hr.requisition</field>
        <field name="arch" type="xml">
            <form string="Requisition">
                <header>
                    <field name="stage_id" widget="statusbar" readonly="1" options="{'fold_field': 'fold'}"/>
                    <button
                        name="action_terminate_recruitment"
                        type="object"
                        string="Terminate Recruitment"
                        class="btn-secondary"
                        invisible="approval_state not in ('approving', 'approved')"
                        groups="tg_hr.group_tg_hr_requisition_terminate,base.group_system"
                        confirm="This will terminate the requisition and reset the approval flow. Continue?"
                    />
                    <field name="approval_state" invisible="1"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Customer Service for swap query handling"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Request">
                            <field name="requester_id" widget="many2one_avatar_user"
                                   options="{'no_quick_create': True, 'no_quick_create_edit': True}"/>
                            <field name="date_request"/>
                            <field name="priority"/>
                            <field name="reason_requisition"
                                   placeholder="Why this headcount or replacement is needed…"/>
                            <field name="date_join_expected"/>
                        </group>
                        <group string="Position">
                            <field name="department_id" options="{'no_quick_create': True, 'no_quick_create_edit': True}"/>
                            <field name="reporting_to_id" widget="many2one_avatar_user"
                                   options="{'no_quick_create': True, 'no_quick_create_edit': True}"/>
                            <field name="job_id" options="{'no_quick_create': True, 'no_quick_create_edit': False}"/>
                            <field name="hiring_type"/>
                            <field name="replacement_partner_id" invisible="hiring_type != 'replacement'"
                                   required="hiring_type == 'replacement'" options="{'no_quick_create': True, 'no_quick_create_edit': True}"/>
                        </group>
                    </group>
                    <group string="JOB DESCRIPTION">
                        <field name="key_responsibility" colspan="4" nolabel="1" placeholder="Main duties…"/>
                    </group>
                    <group string="Qualification">
                        <field name="key_skills"/>
                        <field name="experience_years"/>
                    </group>
                    <group string="Other Information">
                        <field name="number_of_vacancies" widget="radio" options="{'horizontal': true}"/>
                        <field name="salary_grade"/>
                    </group>
                    <group string="HIRING MANAGER">
                        <field name="hiring_status"/>
                        <field name="hiring_manager_id" widget="many2one_avatar_user" invisible="not hiring_manager_id"
                               options="{'no_quick_create': True, 'no_quick_create_edit': True}"/>
                    </group>
                    <group string="Hiring Information Person">
                        <field name="hired_person_ids" nolabel="1" colspan="4">
                            <list editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="name"/>
                                <field name="contact"/>
                                <field name="joining_date"/>
                                <field name="cv" filename="cv_filename"/>
                            </list>
                        </field>
                    </group>
                    <field name="active" invisible="1"/>
                    <field name="description" nolabel="1" placeholder="Internal notes (not on the paper form)…"/>
                </sheet>
                <chatter open_attachments="True" reload_on_attachment="True"/>
            </form>
        </field>
    </record>

    <record id="view_tg_hr_requisition_search" model="ir.ui.view">
        <field name="name">tg.hr.requisition.search</field>
        <field name="model">tg.hr.requisition</field>
        <field name="arch" type="xml">
            <search string="Requisitions">
                <field name="name"/>
                <field name="department_id"/>
                <field name="job_id"/>
                <field name="requester_id"/>
                <field name="reporting_to_id"/>
                <field name="hiring_manager_id"/>
                <field name="replacement_partner_id"/>
                <field name="reason_requisition"/>
                <separator/>
                <filter string="Urgent" name="filter_urgent" domain="[('priority', '=', '3')]"/>
                <filter string="High or Urgent" name="filter_high_up" domain="[('priority', 'in', ('2', '3'))]"/>
                <filter string="Replacement" name="filter_replacement" domain="[('hiring_type', '=', 'replacement')]"/>
                <filter string="New Headcount" name="filter_new_hc" domain="[('hiring_type', '=', 'new')]"/>
                <separator/>
                <filter string="Draft" name="filter_draft" domain="[('stage_id.code', '=', 'draft')]"/>
                <filter string="Submitted" name="filter_submitted" domain="[('stage_id.code', '=', 'submitted')]"/>
                <filter string="Hiring Manager Assigned" name="filter_hm"
                        domain="[('stage_id.code', '=', 'hm_assigned')]"/>
                <filter string="Hired" name="filter_hired" domain="[('stage_id.code', '=', 'hired')]"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Stage" name="group_by_stage" context="{'group_by': 'stage_id'}"/>
                    <filter string="Priority" name="group_by_priority" context="{'group_by': 'priority'}"/>
                    <filter string="Hiring Type" name="group_by_hiring_type" context="{'group_by': 'hiring_type'}"/>
                    <filter string="Department" name="group_by_department" context="{'group_by': 'department_id'}"/>
                    <filter string="Job" name="group_by_job" context="{'group_by': 'job_id'}"/>
                    <filter string="Date of Request" name="group_by_date_request"
                            context="{'group_by': 'date_request'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_tg_hr_requisition" model="ir.actions.act_window">
        <field name="name">Requisitions</field>
        <field name="res_model">tg.hr.requisition</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_group_by_stage': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a job requisition
            </p>
            <p>
                Track requisitions from draft through hired. Move cards on the kanban or use the form buttons.
            </p>
        </field>
    </record>
</odoo>
