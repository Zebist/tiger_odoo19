<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 通讯录等场景使用的 hr.employee.public 表单：不展示简历与认证页签 -->
    <record id="hr_employee_public_view_form_hide_resume_certification" model="ir.ui.view">
        <field name="name">hr.employee.public.form.hide.resume.certification</field>
        <field name="model">hr.employee.public</field>
        <field name="inherit_id" ref="hr.hr_employee_public_view_form"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='resume']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[@name='certification']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>
