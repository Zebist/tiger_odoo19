<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_applicant_form_inherit_tg_hr_interview" model="ir.ui.view">
        <field name="name">hr.applicant.form.inherit.tg.hr.interview</field>
        <field name="model">hr.applicant</field>
        <field name="inherit_id" ref="hr_recruitment.hr_applicant_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form//header" position="inside">
                <field name="show_review_button" invisible="1"/>
                <field name="show_first_contact_button" invisible="1"/>
                <field name="show_interview_button" invisible="1"/>
                <field name="show_pass_interview_button" invisible="1"/>
                <field name="is_in_interview_stage" invisible="1"/>
                <field name="interview_passed" invisible="1"/>
                <field name="show_interview_process_page" widget="interview_process_page_focus" />
                <button name="action_open_review_wizard"
                        type="object"
                        string="Review"
                        class="btn-primary"
                        invisible="not show_review_button"
                        groups="base.group_user"/>
                <button name="action_open_first_contact_wizard"
                        type="object"
                        string="Set First Contact"
                        class="btn-primary"
                        invisible="not show_first_contact_button"
                        groups="base.group_user"/>
                <button name="action_open_interview_wizard"
                        type="object"
                        string="Set Interview"
                        class="btn-primary"
                        invisible="not show_interview_button"
                        groups="base.group_user"/>
                <button name="action_pass_interview"
                        type="object"
                        string="Pass Interview"
                        class="btn-primary"
                        invisible="not show_pass_interview_button"
                        groups="base.group_user"/>
            </xpath>

            <xpath expr="//group/group/field[@name='priority']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//group/group/field[@name='priority']" position="after">
                <field name="assigned_hr_id" widget="many2one_avatar_user"
                       options="{'no_quick_create': True, 'no_quick_create_edit': True}"
                       placeholder="Unassigned"/>
            </xpath>

            <xpath expr="//group/group/field[@name='job_id']" position="after">
                <field name="requisition_id"
                       options="{'no_quick_create': True, 'no_quick_create_edit': True}"/>
            </xpath>

            <xpath expr="//notebook/page[1]" position="before">
                <page string="Interview Process" name="tg_hr_interview_process"
                      invisible="is_pool_applicant or not show_interview_process_page">
                    <group>
                        <group string="Initial Screening">
                            <field name="priority" widget="priority" string="Initial Screening Score"/>
                            <field name="resume_reviewed" invisible="1"/>
                            <field name="review_date"/>
                            <field name="initial_screening_notes" placeholder="Notes..."/>
                        </group>
                        <group string="First Contact">
                            <field name="first_contact_made" invisible="1"/>
                            <field name="first_contact_date"/>
                        </group>
                    </group>

                    <group string="Interview" invisible="not is_in_interview_stage">
                        <group>
                            <field name="interview_score" widget="priority"/>
                            <field name="interview_datetime"/>
                            <field name="interview_type"/>
                            <field name="meeting_url" widget="url"/>
                            <field name="interview_notes" placeholder="Notes..."/>
                        </group>
                        <group>
                            <button name="action_open_interview_wizard" type="object" string="Set Interview Details"
                                    class="btn-secondary"
                                    invisible="1"
                                    groups="hr_recruitment.group_hr_recruitment_user,base.group_system"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="hr_kanban_view_applicant_inherit_tg_hr_buttons" model="ir.ui.view">
        <field name="name">hr.applicant.kanban.inherit.tg.hr.buttons</field>
        <field name="model">hr.applicant</field>
        <field name="inherit_id" ref="hr_recruitment.hr_kanban_view_applicant"/>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="inside">
                <field name="show_review_button" invisible="1"/>
                <field name="show_first_contact_button" invisible="1"/>
                <field name="show_interview_button" invisible="1"/>
                <field name="show_pass_interview_button" invisible="1"/>
                <field name="priority" invisible="1"/>
                <field name="interview_score" invisible="1"/>
                <field name="interview_passed" invisible="1"/>
            </xpath>

            <!-- Hide original priority stars in footer (we re-display them with labels) -->
            <xpath expr="//templates/t[@t-name='card']/footer/field[@name='priority']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//templates/t[@t-name='card']/field[@name='job_id']" position="before">
                <div class="d-flex flex-wrap gap-1 mb-2">
                    <a t-if="record.show_review_button.raw_value"
                       name="action_open_review_wizard"
                       type="object"
                       class="btn btn-sm btn-primary">
                        Review
                    </a>
                    <a t-if="record.show_first_contact_button.raw_value"
                       name="action_open_first_contact_wizard"
                       type="object"
                       class="btn btn-sm btn-primary">
                        Set First Contact
                    </a>
                    <a t-if="record.show_interview_button.raw_value"
                       name="action_open_interview_wizard"
                       type="object"
                       class="btn btn-sm btn-primary">
                        Set Interview
                    </a>
                    <a t-if="record.show_pass_interview_button.raw_value"
                       name="action_pass_interview"
                       type="object"
                       class="btn btn-sm btn-success">
                        Pass Interview
                    </a>
                </div>
                <div class="d-flex flex-column gap-1 mb-2">
                    <div class="d-flex align-items-center gap-2">
                        <span class="text-muted small">Initial Screening</span>
                        <field name="priority" widget="priority"/>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="text-muted small">Interview</span>
                        <field name="interview_score" widget="priority"/>
                        <span t-if="record.interview_passed.raw_value" class="badge text-bg-success ms-1">
                            Interview Passed
                        </span>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <record id="hr_applicant_view_form_inherit_tg_hr_stage_fold" model="ir.ui.view">
        <field name="name">hr.applicant.form.inherit.tg.hr.stage.fold</field>
        <field name="model">hr.applicant</field>
        <field name="inherit_id" ref="hr_recruitment.hr_applicant_view_form"/>
        <field name="arch" type="xml">
            <field name="stage_id" widget="rotting_statusbar_duration" position="attributes">
                <attribute name="options">{"clickable": "1", "fold_field": "fold"}</attribute>
            </field>
        </field>
    </record>

    <record id="hr_contract_salary_offer_view_form_inherit_tg_hr_approval" model="ir.ui.view">
        <field name="name">hr.contract.salary.offer.form.inherit.tg.hr.approval</field>
        <field name="model">hr.contract.salary.offer</field>
        <field name="inherit_id" ref="hr_contract_salary.hr_contract_salary_offer_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/header/button[@name='action_send_by_email']" position="after">
                <button
                    name="action_auto_sign_as_company"
                    type="object"
                    string="Sign (Company)"
                    class="btn btn-primary"
                    invisible="not id or state in ['refused', 'expired', 'cancelled'] or not sign_template_id"
                />
                <button
                    name="action_open_sign_document"
                    type="object"
                    string="Candidate Sign Link"
                    class="btn btn-secondary"
                    invisible="not id or state in ['refused', 'expired', 'cancelled'] or not sign_template_id"
                />
                <button
                    name="action_open_company_sign_document"
                    type="object"
                    string="Company Sign Link"
                    class="btn btn-secondary"
                    invisible="not id or state in ['refused', 'expired', 'cancelled'] or not sign_template_id"
                />
            </xpath>
            <xpath expr="//form/sheet/group/group[@name='group_offer']" position="after">
                <group string="Offer Information">
                    <field name="reporting_to_id" options="{'no_quick_create': True}"/>
                    <field name="work_location"/>
                    <field name="basic_salary"/>
                    <field name="house_rent_allowance"/>
                    <field name="medical_allowance"/>
                    <field name="conveyance_allowance"/>
                    <field name="offer_total_amount" readonly="1"/>
                    <field name="basic_salary_upper_zh" />
                </group>
            </xpath>
            <!-- 隐藏原生 state statusbar -->
            <field name="state" widget="statusbar" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <!-- 在 header 插入 approval_state statusbar -->
            <field name="state" widget="statusbar" position="after">
                <field name="approval_state" widget="statusbar"
                       statusbar_visible="draft,approving,approved"
                       readonly="1"/>
            </field>
        </field>
    </record>

    <record id="hr_applicant_view_form_inherit_tg_hr_offer_label" model="ir.ui.view">
        <field name="name">hr.applicant.form.inherit.tg.hr.offer.label</field>
        <field name="model">hr.applicant</field>
        <field name="inherit_id" ref="hr_contract_salary.hr_applicant_view_form"/>
        <field name="arch" type="xml">
            <button name="action_generate_offer" position="attributes">
                <attribute name="string">Create Offer</attribute>
                <attribute name="invisible">not active or application_status == 'hired' or is_pool_applicant or salary_offers_count > 0 or not is_in_interview_stage or not interview_passed</attribute>
            </button>
        </field>
    </record>
</odoo>
