<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_applicant_form_inherit_tg_hr_interview" model="ir.ui.view">
        <field name="name">hr.applicant.form.inherit.tg.hr.interview</field>
        <field name="model">hr.applicant</field>
        <field name="inherit_id" ref="hr_recruitment.hr_applicant_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form//header" position="inside">
                <field name="show_review_button" invisible="1"/>
                <field name="show_first_contact_button" invisible="1"/>
                <field name="show_interview_button" invisible="1"/>
                <field name="show_pass_interview_button" invisible="1"/>
                <field name="is_in_interview_stage" invisible="1"/>
                <field name="interview_passed" invisible="1"/>
                <field name="show_interview_process_page" widget="interview_process_page_focus" />
                <button name="action_open_review_wizard"
                        type="object"
                        string="Review"
                        class="btn-primary"
                        invisible="not show_review_button"
                        groups="base.group_user"/>
                <button name="action_open_first_contact_wizard"
                        type="object"
                        string="Set First Contact"
                        class="btn-primary"
                        invisible="not show_first_contact_button"
                        groups="base.group_user"/>
                <button name="action_open_interview_wizard"
                        type="object"
                        string="Set Interview"
                        class="btn-primary"
                        invisible="not show_interview_button"
                        groups="base.group_user"/>
                <button name="action_pass_interview"
                        type="object"
                        string="Pass Interview"
                        class="btn-primary"
                        invisible="not show_pass_interview_button"
                        groups="base.group_user"/>
            </xpath>

            <xpath expr="//group/group/field[@name='priority']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//group/group/field[@name='priority']" position="after">
                <field name="assigned_hr_id" widget="many2one_avatar_user"
                       options="{'no_quick_create': True, 'no_quick_create_edit': True}"
                       placeholder="Unassigned"/>
            </xpath>

            <xpath expr="//group/group/field[@name='job_id']" position="after">
                <field name="requisition_id"
                       options="{'no_quick_create': True, 'no_quick_create_edit': True}"/>
                <field name="employee_id" readonly="1"
                       options="{'no_open': False}"
                       invisible="not employee_id"/>
            </xpath>

            <xpath expr="//notebook/page[1]" position="before">
                <page string="Interview Process" name="tg_hr_interview_process"
                      invisible="is_pool_applicant or not show_interview_process_page">
                    <group>
                        <group string="Initial Screening">
                            <field name="priority" widget="priority" string="Initial Screening Score"/>
                            <field name="resume_reviewed" invisible="1"/>
                            <field name="review_date"/>
                            <field name="initial_screening_notes" placeholder="Notes..."/>
                        </group>
                        <group string="First Contact">
                            <field name="first_contact_made" invisible="1"/>
                            <field name="first_contact_date"/>
                        </group>
                    </group>

                    <group string="Interview" invisible="not is_in_interview_stage">
                        <group>
                            <field name="interview_score" widget="priority"/>
                            <field name="interview_datetime"/>
                            <field name="interview_type"/>
                            <field name="meeting_url" widget="url"/>
                            <field name="interview_notes" placeholder="Notes..."/>
                        </group>
                        <group>
                            <button name="action_open_interview_wizard" type="object" string="Set Interview Details"
                                    class="btn-secondary"
                                    invisible="1"
                                    groups="hr_recruitment.group_hr_recruitment_user,base.group_system"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="hr_kanban_view_applicant_inherit_tg_hr_buttons" model="ir.ui.view">
        <field name="name">hr.applicant.kanban.inherit.tg.hr.buttons</field>
        <field name="model">hr.applicant</field>
        <field name="inherit_id" ref="hr_recruitment.hr_kanban_view_applicant"/>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="inside">
                <field name="show_review_button" invisible="1"/>
                <field name="show_first_contact_button" invisible="1"/>
                <field name="show_interview_button" invisible="1"/>
                <field name="show_pass_interview_button" invisible="1"/>
                <field name="priority" invisible="1"/>
                <field name="interview_score" invisible="1"/>
                <field name="interview_passed" invisible="1"/>
            </xpath>

            <!-- Hide original priority stars in footer (we re-display them with labels) -->
            <xpath expr="//templates/t[@t-name='card']/footer/field[@name='priority']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//templates/t[@t-name='card']/field[@name='job_id']" position="before">
                <div class="d-flex flex-wrap gap-1 mb-2">
                    <a t-if="record.show_review_button.raw_value"
                       name="action_open_review_wizard"
                       type="object"
                       class="btn btn-sm btn-primary">
                        Review
                    </a>
                    <a t-if="record.show_first_contact_button.raw_value"
                       name="action_open_first_contact_wizard"
                       type="object"
                       class="btn btn-sm btn-primary">
                        Set First Contact
                    </a>
                    <a t-if="record.show_interview_button.raw_value"
                       name="action_open_interview_wizard"
                       type="object"
                       class="btn btn-sm btn-primary">
                        Set Interview
                    </a>
                    <a t-if="record.show_pass_interview_button.raw_value"
                       name="action_pass_interview"
                       type="object"
                       class="btn btn-sm btn-success">
                        Pass Interview
                    </a>
                </div>
                <div class="d-flex flex-column gap-1 mb-2">
                    <div class="d-flex align-items-center gap-2">
                        <span class="text-muted small">Initial Screening</span>
                        <field name="priority" widget="priority"/>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="text-muted small">Interview</span>
                        <field name="interview_score" widget="priority"/>
                        <span t-if="record.interview_passed.raw_value" class="badge text-bg-success ms-1">
                            Interview Passed
                        </span>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <record id="hr_applicant_view_form_inherit_tg_hr_stage_fold" model="ir.ui.view">
        <field name="name">hr.applicant.form.inherit.tg.hr.stage.fold</field>
        <field name="model">hr.applicant</field>
        <field name="inherit_id" ref="hr_recruitment.hr_applicant_view_form"/>
        <field name="arch" type="xml">
            <field name="stage_id" widget="rotting_statusbar_duration" position="attributes">
                <attribute name="options">{"clickable": "1", "fold_field": "fold"}</attribute>
            </field>
        </field>
    </record>

    <record id="hr_contract_salary_offer_view_form_inherit_tg_hr_approval" model="ir.ui.view">
        <field name="name">hr.contract.salary.offer.form.inherit.tg.hr.approval</field>
        <field name="model">hr.contract.salary.offer</field>
        <field name="inherit_id" ref="hr_contract_salary.hr_contract_salary_offer_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/header/button[@name='action_send_by_email']" position="after">
                <button
                    name="action_auto_sign_as_company"
                    type="object"
                    string="Sign (Company)"
                    class="btn btn-primary"
                    invisible="not id or state in ['refused', 'expired', 'cancelled'] or not sign_template_id"
                />
                <button
                    name="action_open_sign_document"
                    type="object"
                    string="Candidate Sign Link"
                    class="btn btn-secondary"
                    invisible="not id or state in ['refused', 'expired', 'cancelled'] or not sign_template_id"
                />
                <button
                    name="action_open_company_sign_document"
                    type="object"
                    string="Company Sign Link"
                    class="btn btn-secondary"
                    invisible="not id or state in ['refused', 'expired', 'cancelled'] or not sign_template_id"
                />
            </xpath>
            <xpath expr="//form/sheet/group/group[@name='group_offer']" position="after">
                <group string="Offer Information">
                    <field name="reporting_to_id" options="{'no_quick_create': True}"/>
                    <field name="work_location"/>
                    <field name="structure_type_id" readonly="1"/>
                    <field name="wage"/>
                    <field name="basic_salary" readonly="1"/>
                    <field name="house_rent_allowance" readonly="1"/>
                    <field name="medical_allowance" readonly="1"/>
                    <field name="conveyance_allowance" readonly="1"/>
                    <field name="offer_total_amount" readonly="1"/>
                    <field name="basic_salary_upper_zh" />
                </group>
            </xpath>
            <!-- 隐藏原生 state statusbar -->
            <field name="state" widget="statusbar" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <!-- 在 header 插入 approval_state statusbar -->
            <field name="state" widget="statusbar" position="after">
                <field name="approval_state" widget="statusbar"
                       statusbar_visible="draft,approving,approved"
                       readonly="1"/>
            </field>
        </field>
    </record>

    <!-- ── Onboarding Preparation Page ─────────────────────────────────── -->
    <record id="view_hr_applicant_form_inherit_tg_hr_onboarding" model="ir.ui.view">
        <field name="name">hr.applicant.form.inherit.tg.hr.onboarding</field>
        <field name="model">hr.applicant</field>
        <field name="inherit_id" ref="hr_recruitment.hr_applicant_view_form"/>
        <field name="arch" type="xml">
            <!-- header 按钮：onboarding_complete 时才显示 Create Employee（原生按钮） -->
            <xpath expr="//form//header" position="inside">
                <field name="onboarding_complete" invisible="1"/>
                <field name="show_onboarding_page" invisible="1"/>
                <field name="employee_id" invisible="1"/>
                <button name="action_sync_onboarding_defaults"
                        type="object"
                        string="Sync Defaults"
                        class="btn-secondary"
                        invisible="not show_onboarding_page"
                        groups="base.group_system"/>
            </xpath>

            <!-- 原生 Create Employee 按钮永远隐藏，由 wizard 按钮替代 -->
            <xpath expr="//button[@name='create_employee_from_applicant']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@name='create_employee_from_applicant']" position="after">
                <button name="action_open_create_employee_wizard"
                        type="object"
                        string="Create Employee"
                        class="btn-primary"
                        invisible="not onboarding_complete or employee_id or not show_onboarding_page"
                        groups="hr_recruitment.group_hr_recruitment_user"/>
            </xpath>

            <xpath expr="//notebook/page[1]" position="before">
                <page string="Onboarding Preparation" name="tg_hr_onboarding"
                      invisible="not show_onboarding_page">

                    <!-- 进度横幅 -->
                    <div class="alert alert-warning mb-3"
                         invisible="onboarding_complete">
                        <field name="onboarding_done_count" readonly="1"/> / <field name="onboarding_total_count" readonly="1"/> items completed — please fill in all required information before creating the employee.
                    </div>
                    <div class="alert alert-success mb-3"
                         invisible="not onboarding_complete">
                        All onboarding items complete. You may now create the employee.
                    </div>

                    <!-- 区域 & 岗位类别 -->
                    <group string="Region &amp; Position">
                        <group>
                            <field name="ob_region"/>
                            <field name="ob_position_type"/>
                        </group>
                    </group>

                    <!-- 个人信息 -->
                    <group string="Personal Information">
                        <group>
                            <field name="partner_name" string="Name (English)" placeholder="Full name in English"/>
                            <field name="ob_local_name"
                                   placeholder="Local official name (Chinese / Bengali / ...) — optional"
                                   help="Optional. The employee's official name in their local language or script (e.g. Chinese characters, Bengali script). Leave blank if not applicable."/>
                            <field name="ob_sex"/>
                            <field name="ob_birthday"/>
                            <field name="ob_nationality_id" options="{'no_quick_create': True}"/>
                            <field name="partner_phone" string="Phone"/>
                            <field name="ob_emergency_contact"/>
                            <field name="ob_emergency_phone"/>
                        </group>
                        <group>
                            <field name="chk_personal_info" widget="boolean_toggle" readonly="1" string="✓ Personal Info"/>
                        </group>
                    </group>

                    <!-- 证件信息 -->
                    <group string="ID Information">
                        <group>
                            <field name="ob_identification_id"
                                   string="National ID (NID)"
                                   required="ob_region in ['tb','tl'] or (ob_region in ['sg','cn'] and not ob_passport_id)"
                                   invisible="ob_region not in ['sg','cn','tb','tl']"/>
                            <field name="ob_passport_id"
                                   required="ob_region in ['sg','cn'] and not ob_identification_id"
                                   invisible="ob_region not in ['sg','cn']"/>
                            <field name="ob_passport_expiration_date"
                                   required="ob_passport_id and ob_region in ['sg','cn']"
                                   invisible="not ob_passport_id or ob_region not in ['sg','cn']"/>
                        </group>
                        <group>
                            <field name="chk_id_info" widget="boolean_toggle" readonly="1" string="✓ ID Info"/>
                        </group>
                    </group>

                    <!-- 银行信息 -->
                    <group string="Bank Information">
                        <group>
                            <field name="ob_bank_name"/>
                            <field name="ob_bank_account_number"/>
                            <field name="ob_bank_account_holder"/>
                            <field name="ob_swift_code"/>
                        </group>
                        <group>
                            <field name="chk_bank_info" widget="boolean_toggle" readonly="1" string="✓ Bank Info"/>
                        </group>
                    </group>

                    <!-- 税务信息 -->
                    <group string="Tax Information"
                           invisible="ob_region not in ['tb','tl']">
                        <group>
                            <field name="ob_tin_number" string="TIN (Tax ID)"
                                   required="ob_region in ['tb','tl']"/>
                        </group>
                        <group>
                            <field name="chk_tax_info" widget="boolean_toggle" readonly="1" string="✓ Tax Info"/>
                        </group>
                    </group>

                    <!-- 合同信息 -->
                    <group string="Contract Information">
                        <group>
                            <field name="ob_employee_type"/>
                            <field name="job_id" options="{'no_quick_create': True}"/>
                            <field name="department_id" options="{'no_quick_create': True}"/>
                            <field name="ob_manager_id" options="{'no_quick_create': True}"/>
                            <field name="salary_proposed" string="Proposed Salary"/>
                            <field name="ob_trial_period_months"/>
                        </group>
                        <group>
                            <field name="chk_contract_info" widget="boolean_toggle" readonly="1" string="✓ Contract Info"/>
                        </group>
                    </group>

                    <!-- 外派专项 -->
                    <group string="Expat Information"
                           invisible="ob_position_type != 'expat'">
                        <group>
                            <field name="ob_visa_no"/>
                            <field name="ob_visa_expire"/>
                            <field name="ob_work_permit_expiration_date"/>
                        </group>
                        <group>
                            <field name="chk_expat_info" widget="boolean_toggle" readonly="1" string="✓ Expat Info"/>
                        </group>
                    </group>

                    <!-- 工厂专项：安全培训 -->
                    <group string="Factory: Safety Training"
                           invisible="ob_position_type != 'factory'">
                        <group>
                            <field name="chk_safety_training" widget="boolean_toggle" readonly="1" string="Safety Training Confirmed"/>
                            <field name="ob_safety_training_notes"/>
                        </group>
                    </group>

                    <!-- 附件上传 -->
                    <group string="Onboarding Documents">
                        <group col="1" colspan="2">
                            <field name="onboarding_attachment_ids"
                                   nolabel="1"
                                   mode="list">
                                <list editable="bottom">
                                    <field name="attachment_type" required="1"/>
                                    <field name="name" required="1"/>
                                    <field name="file" widget="binary" filename="file_filename" required="1"/>
                                    <field name="file_filename" optional="hide"/>
                                </list>
                            </field>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="chk_id_documents" widget="boolean_toggle" readonly="1" string="✓ ID Scan Uploaded"/>
                            <field name="chk_diploma" widget="boolean_toggle" readonly="1" string="✓ Diploma Uploaded"/>
                            <field name="chk_resignation_proof" widget="boolean_toggle" readonly="1" string="✓ Resignation Proof Uploaded"/>
                        </group>
                    </group>


                </page>
            </xpath>
        </field>
    </record>

    <record id="hr_applicant_view_form_inherit_tg_hr_offer_label" model="ir.ui.view">
        <field name="name">hr.applicant.form.inherit.tg.hr.offer.label</field>
        <field name="model">hr.applicant</field>
        <field name="inherit_id" ref="hr_contract_salary.hr_applicant_view_form"/>
        <field name="arch" type="xml">
            <button name="action_generate_offer" position="attributes">
                <attribute name="string">Create Offer</attribute>
                <attribute name="invisible">not active or application_status == 'hired' or is_pool_applicant or has_active_offer or (not is_in_interview_stage and not is_in_offered_stage) or not interview_passed</attribute>
            </button>
        </field>
    </record>
</odoo>
