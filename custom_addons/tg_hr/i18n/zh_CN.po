#. module: tg_hr
#: model:mail.template,body_html:tg_hr.mail_template_offer_en_tiger
msgid ""
"<div style=\"margin:0px; padding:0px; font-size:14px; line-height:1.6; color:#333;\">\n"
"    <p>Dear <t t-out=\"object.applicant_id.partner_name or ''\"/>,</p>\n"
"    <p>\n"
"        Greetings from HRD of <t t-out=\"object.company_id.name or ''\"/>, a sister concern of Tiger New Energy Co., Ltd.!\n"
"    </p>\n"
"    <p>\n"
"        Congratulations! You have been selected as a\n"
"        <strong t-out=\"object.employee_job_id.name or object.job_title or ''\"/>\n"
"        under the <strong t-out=\"object.department_id.name or ''\"/>\n"
"        of <strong t-out=\"object.company_id.name or ''\"/>.\n"
"        Your job location will be <strong t-out=\"(object.work_location_id.name if object.work_location_id else '')\"/>.\n"
"    </p>\n"
"    <p>\n"
"        Your working hour will be <strong t-out=\"object.working_time_text or ''\"/>\n"
"        from Saturday to Thursday, 6 days in a week.\n"
"    </p>\n"
"    <p style=\"margin-bottom:4px;\"><strong>Salary:</strong></p>\n"
"    <ul style=\"margin-top:0;\">\n"
"        <li>Wage: <t t-out=\"object.wage or 0\"/> <t t-out=\"object.currency_id.name or ''\"/> / month</li>\n"
"        <li>TADA: In station: As per company policy</li>\n"
"        <li>TADA: Out station: At actual cost</li>\n"
"        <li>Performance Bonus: As per company policy</li>\n"
"        <li>Festival bonuses: 2 (Per year)</li>\n"
"        <li>Mobile Allowance: As per company policy</li>\n"
"        <li>Leave Encashment: As per organizational policy</li>\n"
"    </ul>\n"
"    <p>Your Supervisor: <strong t-out=\"object.reporting_to_id.name or ''\"/></p>\n"
"    <p>\n"
"        You are requested to submit the required documents as per the list of documents we have provided hereby.\n"
"        Also, you are requested to join us on\n"
"        <strong t-out=\"object.contract_start_date or ''\"/>\n"
"        at 9:30 am at our head office\n"
"        (20F, Suvastu Muskan Tower, Plot 56, Gulshan Avenue, Gulshan 1, Dhaka-1212.)\n"
"    </p>\n"
"    <p>Please fill up the below-mentioned documents and send them back to us through the mail. Give us a reply if you accept the offer.</p>\n"
"    <br/>\n"
"    <p style=\"margin-bottom:0;\">\n"
"        Warm Regards,<br/>\n"
"        <strong t-out=\"object.offer_sender_id.name or ''\"/><br/>\n"
"        <t t-out=\"object.offer_sender_id.job_title or ''\"/><br/>\n"
"        Human Resources Department<br/>\n"
"        <t t-out=\"object.company_id.name or ''\"/>\n"
"    </p>\n"
"</div>\n"
"        "
msgstr ""

#. module: tg_hr
#: model:mail.template,body_html:tg_hr.mail_template_offer_zh_zuojin
msgid ""
"<div style=\"margin:0px; padding:0px; font-size:14px; line-height:1.7; color:#333;\">\n"
"    <p>\n"
"        <t t-out=\"object.applicant_id.partner_name or ''\"/>，您好！\n"
"    </p>\n"
"    <p>\n"
"        恭喜你，你已顺利通过<strong t-out=\"object.company_id.name or ''\"/>面试。<br/>\n"
"        如你确认入职，后续我们将发送正式劳动合同，安排线上 / 线下签约。\n"
"    </p>\n"
"    <p>请你提前整理并提供、准备以下入职所需资料及个人信息：</p>\n"
"    <ol>\n"
"        <li>本人联系电话、常用邮箱</li>\n"
"        <li>身份证复印件</li>\n"
"        <li>学历、学位证书复印件</li>\n"
"        <li>上家单位离职证明</li>\n"
"        <li>紧急联系人姓名 + 紧急联系电话</li>\n"
"        <li>本人名下银行卡信息（卡号 + 完整开户行名称）</li>\n"
"    </ol>\n"
"    <p>后续如有任何问题，欢迎随时和我沟通。</p>\n"
"    <br/>\n"
"    <p style=\"margin-bottom:0;\">\n"
"        <strong t-out=\"object.company_id.name or ''\"/><br/>\n"
"        人力资源部\n"
"    </p>\n"
"</div>\n"
"        "
msgstr ""

